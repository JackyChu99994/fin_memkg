# 复制为 .env 后填入自己的凭据；不要提交到 Git
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型（2026-10 官方在售）：
#   deepseek-flash    = DeepSeek-V4.1-Flash-1017，便宜，默认开思考模式
#   deepseek-v4-pro   = DeepSeek-V4-Pro-0813，更强，价格约 4 倍
#   deepseek-chat     = 旧别名，实测映射到 flash 的「非思考模式」，结构化抽取最划算
DEEPSEEK_MODEL=deepseek-chat

# Neo4j AuraDB
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=xxxxxxxxxxxxxxxx
NEO4J_DATABASE=xxxxxxxx

# auto = 有 Neo4j 配置就上 Aura，否则用本地 JSON 兜底
MEMKG_STORE=auto
# 基准指数：000300 沪深300（新浪源）
MEMKG_BENCHMARK=000300
