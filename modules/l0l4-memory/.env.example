# Existing root Qwen configuration can be reused without copying its key here.
# Process variables override module .env, which overrides repository .env.
MEMKG_LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Optional alternative: explicitly select deepseek above. Failures never switch models.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Neo4j AuraDB
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# auto = 有 Neo4j 配置就上 Aura，否则用本地 JSON 兜底
MEMKG_STORE=auto
# 基准指数：000300 沪深300（新浪源）
MEMKG_BENCHMARK=000300
